# Copy this file to .env and fill in the values (.env is never uploaded to GitHub)

# MongoDB — local run. In Docker, docker-compose.yml sets it to the mongodb container.
MONGODB_URI=mongodb://127.0.0.1:27017/vacationsDB

PORT=3001

# Any long random text — signs the login tokens
JWT_SECRET=put-a-long-random-secret-here

# Google Gemini (free key: https://aistudio.google.com) — for the AI page and the MCP page
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3-flash-preview